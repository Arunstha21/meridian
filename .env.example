DATABASE_BACKEND=postgres
# Workers uses cloud-sqlite without DATABASE_URL; see wrangler.jsonc.
DATABASE_URL=postgres://meridian:meridian@localhost:5432/meridian
APP_URL=http://localhost:3000
AUTH_MODE=password
# For Cloudflare Access deployments, set AUTH_MODE=cloudflare-access and configure:
# CF_ACCESS_TEAM_DOMAIN=rangotengo.cloudflareaccess.com
# CF_ACCESS_AUD=<Application Audience tag from the Meridian Access application>
# CF_ACCESS_ALLOWED_EMAILS=<comma-separated exact email addresses>
# Or explicitly allow anyone with a verified Access identity to create a household:
# CF_ACCESS_PUBLIC_SIGNUP=true
LOG_LEVEL=info
MAIL_TRANSPORT=console
# MAIL_FROM=no-reply@example.com
# ADMIN_EMAILS only blocks these addresses from family invitations; it never grants admin.
# Promote platform admins with: npm run admin:promote -- <email>
ADMIN_EMAILS=
SEED_DEMO=false
SEED_PASSWORD=
# Access deployments can use MAIL_TRANSPORT=manual for shared invitation links.
# Password deployments require real SMTP in production (console transport is refused
# when NODE_ENV=production, and MAIL_FROM must be set with it):
# SMTP_URL=smtp://user:pass@smtp.example.com:587
SMTP_URL=
DEBUG_LOG_RETENTION_DAYS=90
WORKER_POLL_MS=500
WORKER_NAME=
REQUIRE_EMAIL_VERIFICATION=false
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Required only when connecting MeroShare. Generate with: openssl rand -base64 32
MERO_SHARE_ENCRYPTION_KEY=
TEST_DATABASE_URL=postgres://meridian:meridian@localhost:5432/meridian_test
